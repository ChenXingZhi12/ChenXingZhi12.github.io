---
import Base from "../layouts/Base.astro";
import { site } from "../config";
const skills = [
  {
    number: "01",
    title: "智能体开发",
    description: "将业务流程组织为可执行的任务链，让模型、工具与知识协同工作。",
    items: [
      "LangGraph / LangChain / Deep Agents",
      "Tool Calling、MCP、RAG / GraphRAG",
      "Embedding、多模态与 Prompt 工程",
    ],
  },
  {
    number: "02",
    title: "质量与评测",
    description: "围绕可观测、可回放、可验证的目标，建立智能体质量闭环。",
    items: [
      "Langfuse 观测、数据集与实验",
      "离线金标、一致性验证与错例归因",
      "生成去重、覆盖校验与质量修复",
    ],
  },
  {
    number: "03",
    title: "工程与交付",
    description:
      "从需求澄清和 PoC 到系统适配、试点验收，推动技术进入真实场景。",
    items: [
      "Python / FastAPI / Pydantic",
      "Android / ADB / uiautomator2 / Pytest",
      "MySQL / PostgreSQL / Redis",
    ],
  },
];
const education = [
  {
    school: "重庆邮电大学",
    degree: "硕士",
    major: "信息与通信工程",
    period: "2022.09 — 2025.06",
  },
  {
    school: "郑州工程技术学院",
    degree: "本科",
    major: "电子信息工程",
    period: "2018.09 — 2022.06",
  },
];
---

<Base
  title="关于"
  description={`${site.author}，${site.role}。关注智能体开发、质量评测与业务场景交付。`}
>
  <header class="page-heading">
    <p class="eyebrow">ABOUT ME</p>
    <h1>
      关于我<span class="title-dot">。</span>
    </h1>
    <p>把技术带进场景，也把实践留下来。</p>
  </header>
  <div class="about-grid">
    <div class="about-main">
      <section class="about-intro" aria-labelledby="intro-heading">
        <span class="eyebrow">你好，很高兴在这里相遇</span>
        <h2 id="intro-heading">我是{site.author}。</h2>
        <p class="about-lead">{site.role}</p>
        <p>
          我拥有信息与通信工程硕士背景，目前从事 AI Agent
          开发与业务场景交付，围绕研发测试效能，参与执行、问答、生成与决策类智能体的开发。
        </p>
        <p>
          我关心智能体如何在真实流程中稳定工作：既包括工具调用、检索与工作流编排，也包括运行观测、质量评测、异常恢复，以及从需求澄清到试点验收的完整过程。
        </p>
        <p>这个网站用来整理项目实践、技术思考和生活记录。{site.description}</p>
      </section>
      <section
        class="profile-section"
        id="skills"
        aria-labelledby="skills-heading"
      >
        <div class="profile-heading">
          <p class="eyebrow">WHAT I WORK WITH</p>
          <h2 id="skills-heading">
            技术能力<span class="section-dot">.</span>
          </h2>
        </div>
        <div class="skill-list">
          {skills.map((skill) => (
            <article class="skill-item">
              <span class="skill-number">{skill.number}</span>
              <div>
                <h3>{skill.title}</h3>
                <p>{skill.description}</p>
                <ul>
                  {skill.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section
        class="profile-section"
        id="experience"
        aria-labelledby="experience-heading"
      >
        <div class="profile-heading">
          <p class="eyebrow">EXPERIENCE</p>
          <h2 id="experience-heading">
            工作实践<span class="section-dot">.</span>
          </h2>
        </div>
        <article class="experience-item">
          <p class="experience-period">2025.07 — 至今</p>
          <h3>FDE / AI Agent 开发工程师</h3>
          <p>围绕研发测试场景，参与企业内部智能体平台的核心开发与场景交付。</p>
          <ul>
            <li>
              深入一线澄清需求，将业务流程拆解为智能体任务、工具、知识和评测集。
            </li>
            <li>
              开发工作流、工具调用、RAG、多模态及状态与异常处理逻辑，推动系统适配与试点落地。
            </li>
            <li>
              建设运行观测与评测链路，通过金标验证、错例分析和质量修复推进迭代。
            </li>
          </ul>
          <a class="text-link" href="/projects/">
            查看项目案例 ↗
          </a>
        </article>
      </section>
      <section
        class="profile-section"
        id="education"
        aria-labelledby="education-heading"
      >
        <div class="profile-heading">
          <p class="eyebrow">EDUCATION</p>
          <h2 id="education-heading">
            教育经历<span class="section-dot">.</span>
          </h2>
        </div>
        {education.map((item) => (
          <article class="education-item">
            <div>
              <h3>
                {item.school}
                <span>{item.degree}</span>
              </h3>
              <p>{item.major}</p>
            </div>
            <span class="education-period">{item.period}</span>
          </article>
        ))}
      </section>
    </div>
    <aside class="about-aside profile-aside">
      <span class="eyebrow">这一页里</span>
      <a href="#skills">
        <span>01</span>
        <div>
          <h3>技术能力</h3>
          <p>开发、评测与工程交付</p>
        </div>
        <span aria-hidden="true">↙</span>
      </a>
      <a href="#experience">
        <span>02</span>
        <div>
          <h3>工作实践</h3>
          <p>从场景到可用的智能体</p>
        </div>
        <span aria-hidden="true">↙</span>
      </a>
      <a href="#education">
        <span>03</span>
        <div>
          <h3>教育经历</h3>
          <p>一路走来的学习经历</p>
        </div>
        <span aria-hidden="true">↙</span>
      </a>
      <div class="profile-contact">
        <p class="eyebrow">保持连接</p>
        <a href={`mailto:${site.email}`}>{site.email} ↗</a>
        <a href={site.github} target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
      </div>
    </aside>
  </div>
</Base>
