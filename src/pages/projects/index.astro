---
import Base from "../../layouts/Base.astro";
import EmptyState from "../../components/EmptyState.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { publishedProjects } from "../../lib/content";
const projects = await publishedProjects();
---

<Base title="项目" description="记录从想法到实现的过程，展示项目与实践。">
  <header class="page-heading">
    <p class="eyebrow">SELECTED WORK & EXPERIMENTS</p>
    <h1>
      项目与实践<span class="title-dot">。</span>
    </h1>
    <p>从一个想法出发，记录实现的过程。</p>
  </header>
  <div class="list-bar">
    <span>全部项目</span>
    <span>{String(projects.length).padStart(2, "0")} 个项目</span>
  </div>
  {projects.length ? (
    <div class="project-grid project-page-grid">
      {projects.map((project, i) => (
        <ProjectCard project={project} number={i + 1} />
      ))}
    </div>
  ) : (
    <EmptyState
      title="作品，正在慢慢积累。"
      description="这里将放下真实的项目、实践过程和成果。第一份记录，留给下一次动手。"
      mark="↗"
    />
  )}
</Base>
