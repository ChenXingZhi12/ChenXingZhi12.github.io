---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import NoteRow from "../components/NoteRow.astro";
import { site } from "../config";
import { publishedNotes, publishedProjects } from "../lib/content";
const projects = (await publishedProjects())
  .filter((project) => project.data.featured)
  .slice(0, 2);
const notes = (await publishedNotes()).slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">
        <span class="small-line"></span> 一个持续生长的个人空间
      </p>
      <h1>
        你好，我是
        <span class="hero-name">
          {site.author}
          <span class="title-dot">。</span>
        </span>
      </h1>
      <p class="hero-description">
        记录<span>技术实践</span>，<br class="mobile-break" />
        也记录<span>生活</span>。
      </p>
      <p class="hero-subtitle">把探索的过程留下，让想法慢慢成为作品。</p>
      <div class="hero-links">
        <a class="button" href="/notes/">
          浏览我的记录 <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about/">
          更多关于我 <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <aside class="hero-note" aria-label="网站介绍">
      <div class="note-top">
        <span class="eyebrow">写在这里</span>
        <span class="note-symbol" aria-hidden="true">
          ✳
        </span>
      </div>
      <p>
        保持好奇，
        <br />
        认真做事，
        <br />
        <span>慢慢积累。</span>
      </p>
      <div class="note-bottom">
        <span>想法 / 实践 / 日常</span>
        <span aria-hidden="true">↙</span>
      </div>
    </aside>
    <div class="hero-bottom">
      <span>个人主页 · 作品集 · 记录</span>
      <span aria-hidden="true">向下探索 ↓</span>
    </div>
  </section>
  {projects.length > 0 && (
    <section class="section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">把想法变成作品</p>
          <h2>
            精选项目<span class="section-dot">.</span>
          </h2>
        </div>
        <a class="text-link" href="/projects/">
          全部项目 ↗
        </a>
      </div>
      <div class="project-grid">
        {projects.map((project, i) => (
          <ProjectCard project={project} number={i + 1} />
        ))}
      </div>
    </section>
  )}
  {notes.length > 0 && (
    <section class="section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">沿途的思考与发现</p>
          <h2>
            最近记录<span class="section-dot">.</span>
          </h2>
        </div>
        <a class="text-link" href="/notes/">
          全部记录 ↗
        </a>
      </div>
      {notes.map((note) => (
        <NoteRow note={note} />
      ))}
    </section>
  )}
  <section class="explore-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">从这里开始</p>
        <h2>
          探索这个空间<span class="section-dot">.</span>
        </h2>
      </div>
      <p class="section-aside">关于做过的事，也关于沿途的思考。</p>
    </div>
    <div class="explore-grid">
      <a href="/projects/" class="explore-item">
        <span class="explore-number">01 / PROJECTS</span>
        <div>
          <h3>
            项目与实践 <span aria-hidden="true">↗</span>
          </h3>
          <p>从一个想法出发，记录实现的过程。</p>
        </div>
      </a>
      <a href="/notes/" class="explore-item">
        <span class="explore-number">02 / NOTES</span>
        <div>
          <h3>
            思考与记录 <span aria-hidden="true">↗</span>
          </h3>
          <p>技术、学习，还有值得留下的日常。</p>
        </div>
      </a>
      <a href="/about/" class="explore-item">
        <span class="explore-number">03 / ABOUT</span>
        <div>
          <h3>
            关于我 <span aria-hidden="true">↗</span>
          </h3>
          <p>认识这个空间背后的人。</p>
        </div>
      </a>
    </div>
  </section>
  <section class="contact-band">
    <div>
      <p class="eyebrow">保持连接</p>
      <h2>交流，让想法走得更远。</h2>
      <p>欢迎通过 GitHub 了解我的代码与项目。</p>
    </div>
    <a
      class="text-link"
      href={site.github}
      target="_blank"
      rel="noopener noreferrer"
    >
      在 GitHub 找到我 ↗
    </a>
  </section>
</Base>
