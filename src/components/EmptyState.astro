---
interface Props {
  title: string;
  description: string;
  mark?: string;
}
const { title, description, mark = "…" } = Astro.props;
---

<div class="empty-state">
  <span class="empty-mark" aria-hidden="true">
    {mark}
  </span>
  <h2>{title}</h2>
  <p>{description}</p>
  <a class="text-link" href="/">
    返回首页 <span aria-hidden="true">↗</span>
  </a>
</div>
