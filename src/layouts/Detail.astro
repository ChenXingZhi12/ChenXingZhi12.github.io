---
import Base from "./Base.astro";
import { dateLabel, noteFilterUrl } from "../lib/content";
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  category?: string;
  kind: "notes" | "projects";
  headings: { depth: number; slug: string; text: string }[];
}
const { title, description, date, tags, category, kind, headings } =
  Astro.props;
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<Base title={title} description={description}>
  <div class="detail-breadcrumb">
    <a href={kind === "notes" ? "/notes/" : "/projects/"}>
      ← 返回{kind === "notes" ? "记录" : "项目"}
    </a>
  </div>
  <article data-pagefind-body class="detail-article">
    <header class="detail-heading">
      <div class="detail-meta">
        <span class="eyebrow">{kind === "notes" ? "NOTES" : "PROJECT"}</span>
        <time datetime={date.toISOString()}>{dateLabel(date)}</time>
        {category && (
          <a href={noteFilterUrl("category", category)}>{category}</a>
        )}
      </div>
      <h1 data-pagefind-meta="title">{title}</h1>
      <p class="detail-description" data-pagefind-meta="description">
        {description}
      </p>
      <div class="tags">
        {tags.map((tag) =>
          kind === "notes" ? (
            <a href={noteFilterUrl("tag", tag)}>#{tag}</a>
          ) : (
            <span>#{tag}</span>
          ),
        )}
      </div>
    </header>
    <div class:list={["detail-grid", { "has-toc": toc.length }]}>
      <div class="prose">
        <slot />
      </div>
      {toc.length > 0 && (
        <aside class="toc" data-pagefind-ignore>
          <nav aria-label="文章目录">
            <p class="eyebrow">本文目录</p>
            <ol>
              {toc.map((heading) => (
                <li class:list={{ "toc-sub": heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>
  </article>
  <div class="detail-end">
    <span>记录于此，继续向前。</span>
    <a class="text-link" href={kind === "notes" ? "/notes/" : "/projects/"}>
      更多{kind === "notes" ? "记录" : "项目"} ↗
    </a>
  </div>
</Base>
